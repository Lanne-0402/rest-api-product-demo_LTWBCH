{
  "info": {
    "_postman_id": "dce0acbf-505d-4b2c-a240-54397900350a",
    "name": "RESTful API Demo - Products",
    "description": "Full CRUD demo. Chỉ khi muốn tạo dữ liệu mẫu: cấu hình MONGO_URI rồi chạy npm run seed:demo (6 sản phẩm, chạy lại không tạo trùng). Khởi động npm start; gửi 02 - Read: danh sách, phân trang trang 1/2, lọc giá, chi tiết theo :id. POST 01 tạo sản phẩm mới và lưu productId; 03 cập nhật, 04 xóa sản phẩm có productId. Không tự seed khi import collection hoặc khởi động server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "58381640"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "productId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Create (POST)",
      "item": [
        {
          "name": "Tạo sản phẩm hợp lệ → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Có trường _id\", () => pm.expect(pm.response.json().data).to.have.property('_id'));",
                  "const id = pm.response.json().data._id;",
                  "if (id) pm.collectionVariables.set('productId', id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bàn phím cơ DareU EK87\",\n  \"price\": 650000,\n  \"quantity\": 20\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "Tạo sản phẩm – giá âm → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400 Bad Request\", () => pm.response.to.have.status(400));",
                  "pm.test(\"success = false\", () => pm.expect(pm.response.json().success).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Chuột Gaming Logitech G102\",\n  \"price\": -200000,\n  \"quantity\": 5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/products"
          }
        }
      ]
    },
    {
      "name": "02 - Read (GET)",
      "item": [
        {
          "name": "Lấy danh sách sản phẩm → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"data là mảng\", () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "pm.test(\"Có trường count\", () => pm.expect(pm.response.json()).to.have.property('count'));",
                  "// Lưu _id của sản phẩm đầu tiên nếu chưa có",
                  "const data = pm.response.json().data;",
                  "if (data && data.length && !pm.collectionVariables.get('productId')) {",
                  "    pm.collectionVariables.set('productId', data[0]._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "Lấy chi tiết 1 sản phẩm theo :id → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Đúng req.params.id trong URL\", () => pm.expect(pm.response.json().data._id).to.eql(pm.collectionVariables.get('productId')));",
                  "pm.test(\"Response chứa sản phẩm và tên\", () => pm.expect(pm.response.json().data.name).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{productId}}"
          }
        },
        {
          "name": "req.query: trang 1 (page=1, limit=3) → 200",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
            "const result = pm.response.json();",
            "pm.test('Trang 1, 3 sản phẩm', () => { pm.expect(result.pagination.page).to.eql(1); pm.expect(result.pagination.limit).to.eql(3); pm.expect(result.data).to.have.lengthOf(3); });",
            "pm.collectionVariables.set('page1FirstId', result.data[0]._id);"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/products?page=1&limit=3" }
        },
        {
          "name": "req.query: trang 2 (page=2, limit=3) → 200",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
            "const result = pm.response.json();",
            "pm.test('Trang khác, đủ dữ liệu sau seed', () => { pm.expect(result.pagination.page).to.eql(2); pm.expect(result.pagination.total).to.be.at.least(6); pm.expect(result.data).to.have.lengthOf(3); pm.expect(result.data[0]._id).not.to.eql(pm.collectionVariables.get('page1FirstId')); });"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/products?page=2&limit=3" }
        },
        {
          "name": "req.query: lọc minPrice=500000 → 200",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
            "pm.test('Mọi giá >= 500000', () => pm.expect(pm.response.json().data.every(p => p.price >= 500000)).to.eql(true));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/products?page=1&limit=3&minPrice=500000" }
        },
        {
          "name": "req.query: page=0 không hợp lệ → 400",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
            "pm.test('Nêu rõ page', () => pm.expect(pm.response.json().message).to.include('page'));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/products?page=0&limit=2" }
        },
        {
          "name": "Lấy sản phẩm – ID sai định dạng → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400 Bad Request\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/id-khong-hop-le"
          }
        },
        {
          "name": "Lấy sản phẩm – ID không tồn tại → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404 Not Found\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/000000000000000000000000"
          }
        }
      ]
    },
    {
      "name": "03 - Update (PATCH)",
      "item": [
        {
          "name": "Cập nhật giá sản phẩm → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Giá đã được cập nhật\", () => pm.expect(pm.response.json().data.price).to.eql(750000));",
                  "pm.test(\"Trả về dữ liệu sau khi cập nhật\", () => pm.expect(pm.response.json().data.price).to.eql(750000));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 750000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/products/{{productId}}"
          }
        },
        {
          "name": "Cập nhật – giá âm → 400 (runValidators)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400 Bad Request\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Validator chặn giá âm\", () => pm.expect(pm.response.json().success).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": -1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/products/{{productId}}"
          }
        },
        {
          "name": "Cập nhật – ID không tồn tại → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404 Not Found\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 500000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/products/000000000000000000000000"
          }
        }
      ]
    },
    {
      "name": "04 - Delete (DELETE)",
      "item": [
        {
          "name": "Xóa sản phẩm → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"success = true\", () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{productId}}"
          }
        },
        {
          "name": "Xóa lại lần 2 → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404 Not Found\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{productId}}"
          }
        },
        {
          "name": "Xóa – ID sai định dạng → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400 Bad Request\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/products/id-khong-hop-le"
          }
        }
      ]
    }
  ]
}
